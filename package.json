{
  "name": "integration-all-in-one",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('node:fs').copyFileSync('dist/app.html','dist/index.html')\"",
    "preview": "vite preview",
    "lint": "eslint src tools tests",
    "format": "prettier --write \"src/**/*.{js,css}\" index.html",
    "test:regression": "node tools/regression/run.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "puppeteer-core": "^23.11.1",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
